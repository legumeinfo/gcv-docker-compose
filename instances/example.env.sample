# One GCV instance, run by ./gcvctl as a Compose project named for this file. Copy it to
# instances/<name>.env.

# Which services to run: services (the microservices) or all (with the GCV web app).
COMPOSE_PROFILES=services

# The host and path the shared proxy serves this instance's microservices at. The path
# must be unique to the instance.
DOMAIN=localhost
MICROSERVICES_PATH=/example

# A prebuilt Redis database, fetched before Redis starts. Leave RDB_URL unset to load
# the database with ./gcvctl load instead.
#RDB_URL=https://example.org/example.rdb
#RDB_SHA256=
